<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0284C7"
                android:endColor="#0369A1" />
            <stroke
                android:width="2dp"
                android:color="#38BDF8" />
            <corners
                android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#240E2442" />
            <stroke
                android:width="1dp"
                android:color="#38BDF8" />
            <corners
                android:radius="20dp" />
        </shape>
    </item>
</selector>
